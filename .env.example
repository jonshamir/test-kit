# Copy this file to ".env" and fill in your own values:
#
#   cp .env.example .env
#
# It is not in git - each person on the team makes their own.
#
# There are two halves below, and the line between them matters more than
# anything else in this file. Read the warning in the middle.


# =============================================================================
# 1. PUBLIC - these reach the browser
# =============================================================================
# Anything starting with VITE_ is copied into the JavaScript that every
# visitor downloads. Treat all of it as published on a billboard.

# Your Supabase project URL.
#   Supabase dashboard -> Project Settings -> Data API
VITE_SUPABASE_URL=

# The PUBLISHABLE key (starts with "sb_publishable_").
#   Supabase dashboard -> Project Settings -> API Keys
# Safe to expose: every table has Row Level Security on with no policies, so
# this key cannot read your data. See docs/02-supabase-setup.md.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Shows /components and the demo pages. Set to false before handing the app
# to the organisation.
VITE_SHOW_DEMOS=true


# =============================================================================
# 2. PRIVATE - these stay on the server
# =============================================================================
# No VITE_ prefix, so Vite does not put them in the browser bundle. They are
# read by code in server/, which runs on Cloudflare.
#
#   *** NEVER add VITE_ to anything in this section. ***
#
# That one prefix is the whole difference between a secret and a billboard.
# If you ever need one of these values in the browser, you have taken a wrong
# turn - ask the server for what you need instead.

# The same URL as above. The server cannot read the VITE_ copy directly, so
# this line borrows its value rather than making you type it twice. Leave it
# exactly as it is - fill in VITE_SUPABASE_URL at the top and this follows.
#
# This line is for local development. The deployed server gets the same value
# from the build - see serverUrlFromEnv in vite.config.ts.
SUPABASE_URL=${VITE_SUPABASE_URL}

# The SECRET key (starts with "sb_secret_").
#   Supabase dashboard -> Project Settings -> API Keys
# This one ignores every database rule. Treat it like a password: never paste
# it into anything under client/, and never give it a VITE_ prefix.
SUPABASE_SECRET_KEY=


# This file never leaves your computer. For the deployed app, you type these
# into the Cloudflare dashboard once:
#
#   VITE_ lines          -> Settings -> Build -> Variables and secrets
#   SUPABASE_SECRET_KEY  -> Settings -> Variables & Secrets, as type "Secret"
#
# SUPABASE_URL is not on that list: the build copies it from VITE_SUPABASE_URL.
#
# Never put SUPABASE_SECRET_KEY in wrangler.jsonc, whatever the Cloudflare
# dashboard suggests - that file is in git. If the dashboard can show you a
# value, it is not a secret.
#
# Forgetting this is the usual reason an app works locally and breaks in
# production. See docs/04-deploy.md.
